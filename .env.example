# Copy to .env for local development. Never commit real values.
SMS_NODE_ENV=development
SMS_PORT=3000
SMS_DB_URL=postgres://sms:sms@localhost:5432/sms_dev
# Integration tests create throwaway databases on this server
SMS_TEST_DB_ADMIN_URL=postgres://sms:sms@localhost:5432/postgres
SMS_SCHOOL_CODE=KSV
SMS_TIMEZONE=Africa/Accra
# Field-encryption master key: path to a file holding 32 random bytes, base64 (Docker secret in production)
SMS_MASTER_KEY_FILE=./var/secrets/master.key
SMS_SESSION_SECRET_FILE=./var/secrets/session.key
SMS_FILE_STORAGE_DIR=./var/storage
SMS_CLAMAV_ENABLED=false
SMS_CLAMAV_HOST=clamav
SMS_SMS_PROVIDER=mock
