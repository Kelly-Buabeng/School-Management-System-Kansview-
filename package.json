{
  "name": "kansview-sms",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "contracts:generate": "pnpm --filter @sms/contracts generate",
    "db:migrate": "node db/tools/migrate.mjs",
    "check:ownership": "bash scripts/check-ownership.sh",
    "dev:all": "./dev.sh",
    "dev:demo": "./dev.sh --demo"
  }
}
