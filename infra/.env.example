# Owner: Agent H. Copy to infra/compose/.env on the server and edit. Contains NO secrets:
# passwords and keys live in infra/secrets/* files (created by scripts/generate-secrets.sh) and reach the
# containers as Docker secrets.

# ---- Address and TLS ----
# LAN (on-premise, works without internet): a local name served by the school router/DNS, and Caddy's own CA.
SMS_DOMAIN=sms.kansview.lan
SMS_TLS=internal
# Cloud VM / public domain instead:
# SMS_DOMAIN=sms.example.edu.gh
# SMS_TLS=it-admin@example.edu.gh      # e-mail for Let's Encrypt notices
SMS_HTTP_PORT=80
SMS_HTTPS_PORT=443
# Only relax if the web app cannot avoid inline <style> tags (keeps the CSP strict by default).
# SMS_CSP_STYLE_SRC='self'

# ---- Application ----
SMS_VERSION=latest
SMS_IMAGE_PREFIX=kansview
SMS_SCHOOL_CODE=KSV
SMS_CLAMAV_ENABLED=true              # false on a 4 GB server (and do not start the clamav profile)
SMS_SMS_PROVIDER=mock
SMS_LOG_LEVEL=info

# ---- Backups ----
# Folder on the SECOND disk (separate from the system disk). Create it first:
#   sudo install -d -o 999 -g 999 -m 0750 /srv/sms-backup /srv/sms-backup/{base,wal,status,offsite-staging}
#   sudo chmod 0755 /srv/sms-backup /srv/sms-backup/status    # the api reads status files (read-only mount)
SMS_BACKUP_DIR=/srv/sms-backup
SMS_BACKUP_TIME=01:30                # nightly full backup, Africa/Accra time
SMS_DISK_MIN_FREE_PERCENT=15
# Off-site copy (rclone remote name and bucket, defined in infra/secrets/rclone.conf). Empty = local only.
RCLONE_REMOTE=
# RCLONE_REMOTE=offsite:kansview-sms-backups

# ---- Monitoring (profile "monitoring") ----
SMS_KUMA_BIND=127.0.0.1
