{
  "name": "@sms/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:rbac-coverage": "vitest run test/d/rbac-coverage.int-spec.ts src/security/permissions.spec.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@sms/contracts": "workspace:*",
    "@sms/db-types": "workspace:*",
    "@sms/shared": "workspace:*",
    "argon2": "^0.43.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "kysely": "^0.28.0",
    "otplib": "^12.0.1",
    "pdfmake": "^0.2.20",
    "pg": "^8.16.0",
    "pg-boss": "^10.3.0",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.12.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "fast-check": "^4.1.0",
    "supertest": "^7.1.0",
    "typescript": "~5.9.0",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1"
  }
}
